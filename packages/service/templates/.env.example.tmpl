# Copy to .env — `jigs service start` loads it into the service process.
# The address the CLI dials lives in jigs.yml, not here; this file is for the
# credential-bearing values git must never see.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:{{POSTGRES_PORT}}/jigs

# Consumed by the suspension primitives (needsHuman, pullRequestGate). Every
# trigger validates both before creating a run.
LINEAR_API_KEY=
GITHUB_TOKEN=

# Signing secret of the org-level Linear webhook.
LINEAR_WEBHOOK_SECRET=

# This factory's Slack app — required once jigs.yml carries a `slack:` block.
# The bot token is on the app's OAuth & Permissions page; the app-level token
# is minted on Basic Information with the connections:write scope.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
