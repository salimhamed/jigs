# This factory repo's config. `jigs bind <remote-url>` adds a target repo here;
# `ingress_url` is the public tunnel address provider webhooks reach.
# ingress_url: https://<machine>.<tailnet>.ts.net
# A binding may also carry `post_create`, `hook_timeout_minutes`, and:
# copy: [.env]  # from bindings/<name>/ in this repo, into the worktree
service:
  # Derived from this factory's path so two factories never fight over a port.
  port: {{SERVICE_PORT}}
  # Where this factory's service hosts the SDK's run dashboard.
  dashboard_port: {{DASHBOARD_PORT}}
# This factory's Slack app, if it has one. Absent means Slack is off; present
# means the service refuses to start without SLACK_BOT_TOKEN and
# SLACK_APP_TOKEN in .env. `jigs slack manifest` prints the app to create.
# slack:
#   channel: C0123ABCDEF          # where run threads open
#   allowed_users: [U0123ABCDEF]  # nobody else is listened to
#   model: anthropic/claude-sonnet-4.5  # OpenRouter id the agent answers on
