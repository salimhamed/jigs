import { fn } from "@jigs/service/steps";
import { z } from "zod";
import { fetchSnapshot } from "../steps/jigs.ts";

export const exampleInputs = z.object({
  note: z.string().default("hello from {{FACTORY_NAME}}"),
  // Optional so `jigs run example` still works before this factory has
  // credentials for Linear.
  ticket: z.string().optional(),
});

type ExampleInputs = z.output<typeof exampleInputs> & { triggerId: string };

// Scaffolding: delete it once this factory has a pipeline of its own. It is
// here so a fresh factory has something `jigs run` can launch end to end.
export async function examplePipeline(inputs: ExampleInputs) {
  "use workflow";

  const said = await fn(say, inputs.note);
  // Every jigs step reaches a pipeline through this factory's own
  // steps/jigs.ts — that file is where the durable step ids come from, which
  // is why it is committed source and not something the build regenerates.
  if (inputs.ticket !== undefined) {
    const snapshot = await fetchSnapshot(inputs.ticket);
    console.log(`[example] ${snapshot.identifier} ${snapshot.title}`);
  }
  return said.output;
}

async function say(note: string) {
  "use step";
  console.log(`[example] ${note}`);
  return { note, at: new Date().toISOString() };
}
