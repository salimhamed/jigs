{
  "name": "jigs",
  "version": "0.1.18",
  "description": "Guides coding agents through repeatable workflows",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Salim Hamed",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jigs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harnesses": {
      "types": "./dist/harnesses/index.d.ts",
      "import": "./dist/harnesses/index.js"
    },
    "./checks": {
      "types": "./dist/checks/index.d.ts",
      "default": "./dist/checks/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "default": "./dist/prompts/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "default": "./dist/steps/index.js"
    },
    "./steps/execute": {
      "types": "./dist/steps/execute.d.ts",
      "default": "./dist/steps/execute.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsdown",
    "gen:prompts": "node scripts/gen-prompts.ts && biome check --write src/prompts/defaults.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.79",
    "ai-sdk-provider-claude-code": "4.1.1",
    "ai-sdk-provider-codex-cli": "2.1.2",
    "commander": "^15.0.0",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  }
}
