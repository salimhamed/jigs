// The sequence review-loop.ts runs, held to through the real jigs blocks.
// The wrappers in ../steps/jigs.ts are faked because they are where the loop
// reaches a network, a git remote and an agent; ../steps/describe-pr.ts is
// faked to keep this factory's title and body prose, and the repair policy
// applied to it, out of these assertions. The blocks themselves run for real,
// resume-first fallbacks and prompts included, so what these tests pin is the
// part this file owns: the order, the CI bound, the merge policy and the
// endings.

import type { WorktreeFacts } from "@salimhamed/jigs";
import {
  type AgentStepConfig,
  type AgentStepResult,
  claude,
  parseOutput,
  unwrapAgentStep,
} from "@salimhamed/jigs/steps";
import type { TicketClaim } from "@salimhamed/jigs/suspension/claim";
import type {
  GateAck,
  GateWake,
  PrRef,
} from "@salimhamed/jigs/suspension/pull-request-gate";
import type { Handoff } from "@salimhamed/jigs/ticket/review";
import type { TicketSnapshot } from "@salimhamed/jigs/ticket/snapshot";
import { beforeEach, expect, test, vi } from "vitest";
import type { DescribePrInput } from "../steps/describe-pr.ts";
import { reviewLoop } from "./review-loop.ts";

type PushResult = { commits: number; headSha: string; dirty: boolean };
type RepoRef = { owner: string; repo: string };
type CiRed = Extract<GateWake, { kind: "ci-red" }>;
type ReviewThread = Extract<
  GateWake,
  { kind: "review-comments" }
>["threads"][number];

// Hoisted above the imports: the mock factories below run while
// ./review-loop.ts is being imported, which is before this module's own body
// has evaluated anything.
const shared = vi.hoisted(() => ({
  calls: {
    trail: [] as string[],
    agent: [] as AgentStepConfig<unknown>[],
    bindings: [] as string[],
    pushes: [] as Array<[string, string, string]>,
    replies: [] as Array<[number, string]>,
    comments: [] as string[],
    merges: [] as number[],
    describes: [] as DescribePrInput[],
    opens: [] as Array<[RepoRef, string, string, string, string]>,
    acks: [] as GateAck[],
    needsHuman: 0,
    gateFinished: false,
  },
  script: {
    wakes: [] as GateWake[],
    outputs: [] as unknown[],
    push: (() => ({
      commits: 1,
      headSha: "pushed",
      dirty: false,
    })) as (nth: number) => PushResult,
    staleResumes: 0,
    mergeError: null as Error | null,
  },
  pr: { owner: "acme", repo: "api", number: 41 } as PrRef,
}));

vi.mock("../steps/jigs.ts", () => {
  const { calls, script, pr } = shared;
  async function* deliver(): AsyncGenerator<
    GateWake,
    void,
    GateAck | undefined
  > {
    try {
      for (const wake of script.wakes) {
        calls.trail.push(`wake ${wake.kind}`);
        const ack = yield wake;
        if (ack !== undefined) calls.acks.push(ack);
      }
      calls.gateFinished = true;
    } finally {
      // What the composition's own finally does: an early return disposes the
      // gate's hook rather than leaving it held.
      calls.trail.push("gate closed");
    }
  }
  return {
    agent: async <T>(
      config: AgentStepConfig<T>,
    ): Promise<AgentStepResult<T>> => {
      calls.trail.push("agent");
      calls.agent.push(config as AgentStepConfig<unknown>);
      if (config.resume !== undefined && script.staleResumes > 0) {
        script.staleResumes -= 1;
        // What the real wrapper does with the step's marker: a session the
        // harness no longer holds becomes the one throw resumeOrRebuild
        // catches.
        unwrapAgentStep({ resumeFailed: "no rollout for thread id 0199-gone" });
      }
      const raw =
        config.output === undefined ? undefined : script.outputs.shift();
      return {
        text: "",
        output: parseOutput(config.output, raw),
        session: { harness: "claude", id: `s-${calls.agent.length}` },
      };
    },
    needsHuman: async () => {
      calls.trail.push("needsHuman");
      calls.needsHuman += 1;
      return {
        commentId: "c1",
        body: "carry on",
        author: { id: "u1", name: "salim" },
        createdAt: "2026-08-26T14:00:00Z",
      };
    },
    gate: (_target: PrRef) => {
      calls.trail.push("gate");
      return deliver();
    },
    resolveRepo: async (binding: string) => {
      calls.trail.push("resolveRepo");
      calls.bindings.push(binding);
      return { owner: pr.owner, repo: pr.repo };
    },
    pushWorktreeBranch: async (
      path: string,
      branch: string,
      baseSha: string,
    ) => {
      calls.trail.push("push");
      calls.pushes.push([path, branch, baseSha]);
      return script.push(calls.pushes.length);
    },
    readDiff: async (_path: string, _baseSha: string) => {
      calls.trail.push("readDiff");
      return "THE-DIFF";
    },
    openPr: async (
      repo: RepoRef,
      head: string,
      base: string,
      title: string,
      body: string,
    ) => {
      calls.trail.push("openPr");
      calls.opens.push([repo, head, base, title, body]);
      return pr;
    },
    replyInThread: async (_target: PrRef, rootId: number, body: string) => {
      calls.trail.push("reply");
      calls.replies.push([rootId, body]);
      return { id: rootId + 1 };
    },
    commentOnPr: async (_target: PrRef, body: string) => {
      calls.trail.push("comment");
      calls.comments.push(body);
    },
    squashMerge: async (target: PrRef) => {
      calls.trail.push("merge");
      if (script.mergeError !== null) throw script.mergeError;
      calls.merges.push(target.number);
      return { merged: true, sha: "merge-sha" };
    },
  };
});

vi.mock("../steps/describe-pr.ts", () => ({
  describePr: async (input: DescribePrInput) => {
    shared.calls.trail.push("describePr");
    shared.calls.describes.push(input);
    return { title: "described title", body: "described body" };
  },
}));

const { calls, script, pr } = shared;

const claim = {
  issueId: "68bc9696-35d5-442d-ab56-214c8cfefbec",
  identifier: "AGE-316",
  token: "linear:ticket:68bc9696-35d5-442d-ab56-214c8cfefbec",
} as TicketClaim;

const snapshot: TicketSnapshot = {
  fetchedAt: "2026-08-26T13:00:00Z",
  id: claim.issueId,
  identifier: "AGE-316",
  title: "Review loop jig",
  description: "## Acceptance criteria\n\n- the builder answers in-thread",
  url: "https://linear.app/x/issue/AGE-316",
  branchName: "salimhamed/age-316-review-loop",
  state: "Todo",
  labels: [],
  comments: [],
  blockedBy: [],
  blocks: [],
  links: [],
  subIssues: [],
};

const handoff: Handoff = { brief: "build it", snapshot };

const worktree: WorktreeFacts = {
  path: "/tmp/worktree",
  branch: snapshot.branchName,
  defaultBranch: "main",
  baseSha: "base-sha-1",
};

const thread = (rootId: number): ReviewThread => ({
  rootId,
  path: "src/gate.ts",
  line: 12,
  comments: [
    {
      id: rootId,
      rootId,
      body: `comment on ${rootId}`,
      user: "reviewer",
      path: "src/gate.ts",
      line: 12,
      createdAt: "2026-08-26T12:00:00Z",
    },
  ],
});

const failing: CiRed["failing"] = [
  { name: "test", conclusion: "failure", url: "http://ci.test/1" },
];

const ciRed = (
  headSha: string,
  mentionLogin: string | null = "salim",
): GateWake => ({ kind: "ci-red", headSha, failing, mentionLogin });

const closedMerged: GateWake = { kind: "closed", merged: true };

const approval: GateWake = {
  kind: "approved",
  reviewId: 7,
  reviewer: "salim",
  submittedAt: "2026-08-26T12:00:00Z",
};

const approved = { verdict: "approved", findings: [] };

const answerFor = (rootIds: number[]) => ({
  answers: rootIds.map((threadId) => ({
    threadId,
    body: `answered ${threadId}`,
  })),
});

// The first `empty` pushes report a dirty worktree and no commits; every push
// after them carries one.
const emptyPushes =
  (empty: number) =>
  (nth: number): PushResult =>
    nth > empty
      ? { commits: 1, headSha: `pushed-${nth}`, dirty: false }
      : { commits: 0, headSha: "base-sha-1", dirty: true };

const commitRounds = () =>
  calls.agent.filter((call) => call.prompt.startsWith("# Commit your work"));

const ciFixes = () =>
  calls.agent.filter((call) => call.prompt.startsWith("# Fix CI"));

const run = (merge: "jigs" | "human" = "jigs") =>
  reviewLoop({
    claim,
    handoff,
    harness: claude({ model: "sonnet" }),
    worktree,
    binding: "scratch",
    merge,
  });

beforeEach(() => {
  // Assigned into rather than rebound: the mock factories closed over these
  // two objects while ./review-loop.ts was being imported.
  Object.assign(calls, {
    trail: [],
    agent: [],
    bindings: [],
    pushes: [],
    replies: [],
    comments: [],
    merges: [],
    describes: [],
    opens: [],
    acks: [],
    needsHuman: 0,
    gateFinished: false,
  });
  Object.assign(script, {
    wakes: [],
    // The first review verdict every test needs before the PR is opened.
    outputs: [approved],
    push: (nth: number) => ({
      commits: 1,
      headSha: `pushed-${nth}`,
      dirty: false,
    }),
    staleResumes: 0,
    mergeError: null,
  });
});

test("the loop implements, pushes the ticket branch and opens the PR before the gate", async () => {
  script.wakes = [closedMerged];
  const result = await run();

  expect(calls.trail).toEqual([
    "agent",
    "agent",
    "push",
    "describePr",
    "resolveRepo",
    "openPr",
    "gate",
    "wake closed",
    "gate closed",
  ]);
  expect(calls.pushes).toEqual([
    ["/tmp/worktree", snapshot.branchName, "base-sha-1"],
  ]);
  expect(calls.bindings).toEqual(["scratch"]);
  expect(result).toEqual({ pr, cycles: 1 });
});

test("an empty branch with a clean tree fails loudly instead of opening an empty PR", async () => {
  script.push = () => ({ commits: 0, headSha: "base-sha-1", dirty: false });

  await expect(run()).rejects.toThrow(snapshot.branchName);
  // Nothing describes a branch that turned out to carry nothing.
  expect(calls.describes).toEqual([]);
  // Nothing to recover, so no commit round is spent and no second push runs.
  expect(commitRounds()).toEqual([]);
  expect(calls.pushes).toHaveLength(1);
});

test("an empty push with a dirty worktree sends the builder back to commit", async () => {
  script.wakes = [closedMerged];
  script.push = emptyPushes(1);
  const result = await run();

  const rounds = commitRounds();
  expect(rounds).toHaveLength(1);
  // Inside the builder's own session: it is the one holding the work it left
  // uncommitted.
  expect(rounds[0]?.resume).toEqual({ harness: "claude", id: "s-1" });
  expect(rounds[0]?.cwd).toBe("/tmp/worktree");
  // The second push carries the commit, so the run continues into the PR.
  expect(calls.pushes).toHaveLength(2);
  expect(calls.describes).toHaveLength(1);
  expect(result).toEqual({ pr, cycles: 1 });
});

test("a stale session commits from a fresh context rather than failing the run", async () => {
  script.wakes = [closedMerged];
  script.push = emptyPushes(1);
  script.staleResumes = 1;
  const result = await run();

  // The same prompt either way: the work is on disk, so the fresh round needs
  // no rebuilt context of its own.
  const rounds = commitRounds();
  expect(rounds).toHaveLength(2);
  expect(rounds[0]?.resume).toEqual({ harness: "claude", id: "s-1" });
  expect(rounds[1]?.resume).toBeUndefined();
  // The throwing resume records no session, so the fresh round is s-4, and
  // that is the one now holding the change.
  expect(calls.describes[0]?.session).toEqual({ harness: "claude", id: "s-4" });
  expect(result).toEqual({ pr, cycles: 1 });
});

test("a commit round that still commits nothing fails the run", async () => {
  script.push = emptyPushes(2);

  await expect(run()).rejects.toThrow("commit-recovery round");
  // Exactly one round: the recovery is bounded, not a loop.
  expect(commitRounds()).toHaveLength(1);
  expect(calls.pushes).toHaveLength(2);
  expect(calls.describes).toEqual([]);
});

test("the factory's description is what the PR is opened with", async () => {
  script.wakes = [closedMerged];
  await run();

  // The loop holds no title or body of its own: whatever describePr returned
  // is verbatim what GitHub gets.
  expect(calls.describes).toHaveLength(1);
  expect(calls.opens).toEqual([
    [
      { owner: pr.owner, repo: pr.repo },
      snapshot.branchName,
      worktree.defaultBranch,
      "described title",
      "described body",
    ],
  ]);
});

test("describePr sees the builder's session and the branch point", async () => {
  script.wakes = [closedMerged];
  await run();

  // s-1 is the implement call, so a description agent can resume the context
  // that wrote the change rather than reading the diff cold.
  expect(calls.describes[0]?.session).toEqual({ harness: "claude", id: "s-1" });
  expect(calls.describes[0]?.baseSha).toBe("base-sha-1");
  expect(calls.describes[0]?.worktreePath).toBe("/tmp/worktree");
  expect(calls.describes[0]?.handoff).toEqual(handoff);
});

test("a review-comments wake answers every thread in place", async () => {
  script.outputs = [approved, answerFor([900, 910])];
  script.wakes = [
    { kind: "review-comments", threads: [thread(900), thread(910)] },
    closedMerged,
  ];
  await run();

  expect(calls.replies).toEqual([
    [900, "answered 900"],
    [910, "answered 910"],
  ]);
  expect(calls.comments).toEqual([]);
  // The answer prompts have the builder commit its fix, so the branch has to
  // carry it before the reply claims it does.
  expect(calls.pushes).toEqual([
    ["/tmp/worktree", snapshot.branchName, "base-sha-1"],
    ["/tmp/worktree", snapshot.branchName, "base-sha-1"],
  ]);
  expect(calls.trail).toEqual([
    "agent",
    "agent",
    "push",
    "describePr",
    "resolveRepo",
    "openPr",
    "gate",
    "wake review-comments",
    "agent",
    "push",
    "reply",
    "reply",
    "wake closed",
    "gate closed",
  ]);
});

test("the ids of the replies it posts ride back into the gate", async () => {
  script.outputs = [approved, answerFor([900, 910])];
  script.wakes = [
    { kind: "review-comments", threads: [thread(900), thread(910)] },
    closedMerged,
  ];
  await run();

  // What keeps the gate from waking the builder back into a thread whose only
  // new comment is the loop's own reply, without filtering by author.
  expect(calls.acks).toEqual([{ selfCommentIds: [901, 911] }]);
});

