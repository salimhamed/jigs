import { ticketInput } from "@salimhamed/jigs";
import { claimTicket } from "@salimhamed/jigs/suspension/claim";
import { claude, codex } from "@salimhamed/jigs/steps";
import { z } from "zod";
import {
  fetchSnapshot,
  reviewLoop,
  teardownWorktrees,
  ticketReview,
  worktree,
} from "../steps/jigs.ts";

export const shipInputs = z.object({
  ticket: ticketInput,
  // A name from jigs.yml's `bindings:`. Give it a `.default(...)` once this
  // factory has bound its repo, and list the name under `requires.bindings`
  // in jigs.config.ts so preflight refuses a run the worktree step would fail.
  binding: z.string(),
  // "jigs" squash-merges on approval; "human" keeps listening and lets a
  // person press merge. The gate ends either way only when the PR closes.
  merge: z.enum(["jigs", "human"]),
});

// `issueId` and `identifier` are not launch inputs: the trigger resolves
// `ticket` (either form) against Linear and injects both alongside triggerId,
// so the body reads the resolved pair rather than re-resolving it.
type ShipInputs = z.output<typeof shipInputs> & {
  triggerId: string;
  issueId: string;
  identifier: string;
};

// A ticket to a merged pull request: claim ticket → snapshot → ticketReview →
// worktree → reviewLoop (implement ⇄ review → PR → gate → merge) → teardown.
// Everything here is the wired jig from ../steps/jigs.ts; a pipeline that
// needs to swap a dep spreads the exported `reviewLoopDeps` and overrides the
// one entry rather than rebuilding the map.
export async function shipPipeline(inputs: ShipInputs) {
  "use workflow";

  const claim = await claimTicket(inputs.issueId, inputs.identifier);
  const snapshot = await fetchSnapshot(inputs.issueId);

  const workspace = await worktree({
    binding: inputs.binding,
    branch: snapshot.branchName,
  });

  const reviewer = claude({ model: "opus" });
  let review = await ticketReview({
    claim,
    snapshot,
    harness: reviewer,
    cwd: workspace.path,
  });
  // A needs-human verdict parks inside ticketReview until a human replies on
  // the ticket — but the reply lands on the ticket, not in the verdict. Each
  // round re-snapshots so the next review reads it; without this loop the
  // stale brief reaches the builder.
  while (review.verdict === "needs-human") {
    const fresh = await fetchSnapshot(inputs.issueId);
    review = await ticketReview({
      claim,
      snapshot: fresh,
      harness: reviewer,
      cwd: workspace.path,
    });
  }

  const result = await reviewLoop({
    claim,
    handoff: review,
    // The loop threads one harness through its builder, code-reviewer, CI
    // fixer and thread answerer, and the builder is the role that owns the
    // session — so the loop runs on the implementation harness.
    harness: codex({ model: "gpt-5.6-sol" }),
    worktree: workspace,
    binding: inputs.binding,
    merge: inputs.merge,
  });

  // reviewLoop returns only when the PR merged; every thrown ending leaves
  // the worktree for `jigs sweep`. A plain sequential call, never a finally —
  // suspension is a thrown error, and a parked run keeps its worktree.
  await teardownWorktrees();

  return { pr: result.pr, cycles: result.cycles };
}
