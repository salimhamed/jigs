{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [{ "name": "workflow" }]
  },
  "include": [
    "pipelines",
    "steps",
    ".jigs",
    "jigs.config.ts",
    "jigs.config.test.ts",
    "nitro.config.ts"
  ]
}
