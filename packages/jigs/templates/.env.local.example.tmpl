# This copy's own values. Copy this file to .env.local and never copy .env.local to another
# checkout; each copy writes its own. Keep .env.local out of version control.
# Leave a value commented out rather than empty: an empty X= hides the X in .env.

# Each copy on a machine needs its own docker compose project and ports. jigs init suggested these.
COMPOSE_PROJECT_NAME={{FACTORY_NAME}}
JIGS_SERVICE_PORT={{SERVICE_PORT}}
JIGS_DASHBOARD_PORT={{DASHBOARD_PORT}}
JIGS_POSTGRES_PORT={{POSTGRES_PORT}}
# This copy's World, on JIGS_POSTGRES_PORT.
WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:{{POSTGRES_PORT}}/jigs

# Hub: once a workflow, binding or trigger uses GitHub, Linear, Slack or PagerDuty.
# The factory token the hub showed when you added this copy's factory.
# JIGS_HUB_TOKEN=<token>

# Triggers and schedules: one <NAME>_ACTIVE=true for each one this copy runs, plus any per-copy
# value it reads, such as a test channel.
