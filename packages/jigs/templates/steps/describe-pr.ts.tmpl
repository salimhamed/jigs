// How a pull request introduces itself is this factory's voice, so jigs ships
// the mechanics and this file ships the words. `describePr` from
// `@salimhamed/jigs/review-loop` resumes the builder that wrote the change,
// falls back to a fresh context fed the diff, and parses a `{ title, body }`
// back; everything below — the conventions, and what to do when the answer
// drifts out of them — is the part you are meant to rewrite.
//
// No `"use step"` of its own, and none is wanted: this is a workflow-side
// composition over the `agent` jig and the `readDiff` wrapper in ./jigs.ts, so
// the only ids in play stay that file's and nothing here can add or move one.

import { describePr as describePrJig } from "@salimhamed/jigs/review-loop";
import { claude, type AgentSession } from "@salimhamed/jigs/steps";
import type { Handoff } from "@salimhamed/jigs/ticket/review";
import {
  renderSnapshot,
  type TicketSnapshot,
} from "@salimhamed/jigs/ticket/snapshot";
import { agent, readDiff } from "./jigs.ts";

export type DescribePrInput = {
  handoff: Handoff;
  worktreePath: string;
  baseSha: string;
  session?: AgentSession;
};

// This factory's PR conventions. Rewrite them: whatever comes back is what
// GitHub is handed.
function conventions(ticket: TicketSnapshot): string {
  return [
    "Write the title and body of the pull request for this change.",
    "",
    `- Title: \`${ticket.identifier}: \` then a short imperative summary.`,
    "- Body: what changed and why, in prose a reviewer can read in a minute.",
    `- End the body with a link to the ticket: ${ticket.url}`,
  ].join("\n");
}

export async function describePr(input: DescribePrInput) {
  const ticket = input.handoff.snapshot;

  const described = await describePrJig({
    agent,
    readDiff,
    // The describing agent is this factory's own choice, not the loop's: the
    // loop runs on the implementation harness, and prose is a different job.
    // A session recorded on the other harness is the common case here, and the
    // resume fallback reports it as a resume failure like any other.
    harness: claude({ model: "opus" }),
    cwd: input.worktreePath,
    baseSha: input.baseSha,
    ...(input.session === undefined ? {} : { session: input.session }),
    resumePrompt: conventions(ticket),
    freshPrompt: (diff) =>
      [
        conventions(ticket),
        "",
        "## Ticket",
        "",
        renderSnapshot(ticket),
        "",
        "## Brief",
        "",
        input.handoff.brief,
        "",
        "## Diff",
        "",
        diff,
      ].join("\n"),
  });

  return repaired(described, ticket);
}

// This factory's policy for a description that drifts: repair it. A factory
// whose target repo gates on the title — a conventional-commit check, say —
// may prefer to throw here instead, and kill the run rather than open a pull
// request CI will refuse. Only one attempt is on offer either way: the resume
// fallback fires on a resume failure and on nothing else.
function repaired(
  description: { title: string; body: string },
  ticket: TicketSnapshot,
) {
  let { title, body } = description;
  if (!title.startsWith(`${ticket.identifier}: `)) {
    console.log(
      `[describePr] prefixing ${ticket.identifier} onto ${JSON.stringify(title)}`,
    );
    title = `${ticket.identifier}: ${title}`;
  }
  if (!body.includes(ticket.url)) {
    console.log("[describePr] body carries no ticket link — appending one");
    body = `${body}\n\n[${ticket.identifier}](${ticket.url})`;
  }
  return { title, body };
}
