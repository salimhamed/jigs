// This factory's half of every jigs step.
//
// Each `"use step"` function below compiles to a durable id built from this
// file's path and the function's name (`step//./steps/jigs//provisionWorktree`),
// and every id is a memoization key of every run this factory has parked. So
// rename or move an exported wrapper — or this file — only when `jigs ps`
// shows no parked runs; a run whose id moved under it shows up stalled, and
// the way back is to cancel it and relaunch. When a jigs release grows a step,
// add its wrapper here yourself: the typecheck is what names the gap.
//
// The implementations are imported at module scope on purpose: the `"use step"`
// transform erases each body below out of the workflow bundle, and the imports
// only those bodies reach go with it, so the service's node-builtin code never
// crosses into the workflow sandbox.

import type { WorktreeFacts } from "@salimhamed/jigs";
import {
  branchState as branchStateImpl,
  checkForHumanReply as checkForHumanReplyImpl,
  commentOnPr as commentOnPrImpl,
  dashboardRunUrl,
  fetchPrState as fetchPrStateImpl,
  fetchSnapshot as fetchSnapshotImpl,
  openPr as openPrImpl,
  postNeedsHumanComment as postNeedsHumanCommentImpl,
  postTicketNote as postTicketNoteImpl,
  provisionRunWorktree,
  pushBranch as pushBranchImpl,
  readDiff as readDiffImpl,
  replyInThread as replyInThreadImpl,
  resolveRepo as resolveRepoImpl,
  runAgent,
  runAsk,
  squashMerge as squashMergeImpl,
  teardownMergedRun,
  type WorktreeRequest,
} from "@salimhamed/jigs/steps";
import { getWorkflowMetadata } from "workflow";
import { prompts } from "../prompts/index.ts";

export async function provisionWorktree(
  request: WorktreeRequest,
): Promise<WorktreeFacts> {
  "use step";
  return provisionRunWorktree(request, getWorkflowMetadata().workflowRunId);
}

export async function teardownWorktrees() {
  "use step";
  return teardownMergedRun(getWorkflowMetadata().workflowRunId);
}

export async function runAgentStep(wire: Parameters<typeof runAgent>[0]) {
  "use step";
  // The registry is what turns a prompt name on the wire into the words the
  // agent reads, so this factory's own prompts reach the agent from here.
  return runAgent(wire, getWorkflowMetadata().workflowRunId, prompts);
}

export async function runAskStep(wire: Parameters<typeof runAsk>[0]) {
  "use step";
  return runAsk(wire, getWorkflowMetadata().workflowRunId);
}

// The only wrapper that adds to its arguments rather than passing them
// through: what the comment's footer says about the run — the run id, the
// pipeline name, when it paused and where to watch it — is knowable here and
// nowhere block-side. The registry comes along for the same reason it does on
// runAgentStep: the comment is a template, and this factory may have its own.
export async function postNeedsHumanComment(
  issueId: string,
  halt: Parameters<typeof postNeedsHumanCommentImpl>[1],
) {
  "use step";
  const metadata = getWorkflowMetadata();
  return postNeedsHumanCommentImpl(
    issueId,
    halt,
    {
      runId: metadata.workflowRunId,
      pipeline: metadata.workflowName,
      pausedAt: new Date().toISOString(),
      dashboardUrl: dashboardRunUrl(metadata.workflowRunId),
    },
    prompts,
  );
}

export async function postTicketNote(
  issueId: string,
  note: Parameters<typeof postTicketNoteImpl>[1],
) {
  "use step";
  return postTicketNoteImpl(issueId, note, prompts);
}

