// How a pull request introduces itself is this factory's voice: jigs ships the
// mechanics, ../../prompts/describe-pr.ts ships the words, and what is left
// here is what to do when the answer drifts out of this factory's conventions.

import type { WorktreeFacts } from "@salimhamed/jigs";
import {
  claude,
  describePr,
  type Handoff,
  type PrRef,
  type TicketSnapshot,
} from "@salimhamed/jigs/blocks";
import { prDescriptionPrompts } from "../../prompts/describe-pr.ts";
import { openPr, readDiff, resolveRepo } from "../../steps/jigs.ts";
import { agent } from "../jigs.ts";
import type { Builder } from "./builder.ts";

export async function describeAndOpenPr(
  builder: Builder,
  worktree: WorktreeFacts,
  handoff: Handoff,
  binding: string,
): Promise<PrRef> {
  const ticket = handoff.snapshot;
  const prompts = prDescriptionPrompts(handoff);

  const described = await describePr({
    agent,
    readDiff,
    // The describing agent is this factory's own choice, not the loop's: the
    // loop runs on the implementation harness, and prose is a different job.
    // A session recorded on the other harness is the common case here, and the
    // resume fallback reports it as a resume failure like any other.
    harness: claude({ model: "opus" }),
    cwd: builder.cwd,
    baseSha: worktree.baseSha,
    ...(builder.session === undefined ? {} : { session: builder.session }),
    resumePrompt: prompts.resumePrompt,
    freshPrompt: prompts.freshPrompt,
  });

  const { title, body } = repaired(described, ticket);
  const repo = await resolveRepo(binding);
  return openPr(repo, worktree.branch, worktree.defaultBranch, title, body);
}

// This factory's policy for a description that drifts: repair it. A factory
// whose target repo gates on the title — a conventional-commit check, say —
// may prefer to throw here instead, and kill the run rather than open a pull
// request CI will refuse. Only one attempt is on offer either way: the resume
// fallback fires on a resume failure and on nothing else.
function repaired(
  description: { title: string; body: string },
  ticket: TicketSnapshot,
) {
  let { title, body } = description;
  if (!title.startsWith(`${ticket.identifier}: `)) {
    console.log(
      `[describePr] prefixing ${ticket.identifier} onto ${JSON.stringify(title)}`,
    );
    title = `${ticket.identifier}: ${title}`;
  }
  if (!body.includes(ticket.url)) {
    console.log("[describePr] body carries no ticket link — appending one");
    body = `${body}\n\n[${ticket.identifier}](${ticket.url})`;
  }
  return { title, body };
}
