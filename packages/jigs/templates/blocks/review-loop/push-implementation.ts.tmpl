import type { WorktreeFacts } from "@salimhamed/jigs";
import { commitWork } from "@salimhamed/jigs/blocks";
import { branchState, pushBranch } from "../../steps/jigs.ts";
import { agent } from "../jigs.ts";
import type { Builder } from "./builder.ts";

export async function pushImplementation(
  builder: Builder,
  worktree: WorktreeFacts,
): Promise<void> {
  const state = await branchState(builder.cwd, worktree.baseSha);
  if (state.commits > 0) {
    await pushBranch(builder.cwd, worktree.branch);
    return;
  }

  // Thrown workflow-side so the SDK does not retry an empty branch three
  // times. A dirty tree is a complete implementation the builder forgot to
  // commit, so it gets exactly one bounded round to save it; a clean tree has
  // nothing to save.
  const empty = `${worktree.branch} holds no commits since ${worktree.baseSha} — the builder finished without committing, so there is nothing to open a pull request for`;
  if (!state.dirty) throw new Error(empty);

  console.log(
    "[reviewLoop] no commits with a dirty worktree — sending the builder back to commit",
  );
  builder.session =
    (await commitWork({
      agent,
      harness: builder.harness,
      cwd: builder.cwd,
      ...(builder.session === undefined ? {} : { session: builder.session }),
    })) ?? builder.session;

  const after = await branchState(builder.cwd, worktree.baseSha);
  if (after.commits === 0) {
    throw new Error(`${empty}, and a commit-recovery round did not change that`);
  }
  await pushBranch(builder.cwd, worktree.branch);
}
