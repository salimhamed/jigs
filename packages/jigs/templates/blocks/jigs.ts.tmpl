// The jigs blocks this factory uses, bound to the wrappers in ../steps/jigs.ts.
// They carry no directive and own no id: only the steps they call are
// memoized. Every jigs block takes the wrappers it needs as plain parameters,
// so these are the bindings that save every caller from repeating them.

import {
  agent as agentBlock,
  agentOrHalt as agentOrHaltBlock,
  type AgentStepConfig,
  ask as askBlock,
  type AskStepConfig,
  type GateFn,
  haltForHuman as haltForHumanBlock,
  type HaltForHumanFn,
  type Handoff,
  pullRequestGate as pullRequestGateBlock,
  reviewTicket as reviewTicketBlock,
  type ReviewTicketOptions,
  type TicketClaim,
} from "@salimhamed/jigs/blocks";
import {
  checkForHumanReply,
  fetchPrState,
  fetchTicketSnapshot,
  postNeedsHumanComment,
  postTicketNote,
  runAgentStep,
  runAskStep,
} from "../steps/jigs.ts";

export function agent<T = undefined>(config: AgentStepConfig<T>) {
  return agentBlock(config, runAgentStep);
}

export function ask<T = undefined>(config: AskStepConfig<T>) {
  return askBlock(config, runAskStep);
}

export const haltForHuman: HaltForHumanFn = (claim, halt) =>
  haltForHumanBlock(claim, halt, {
    postComment: postNeedsHumanComment,
    checkForReply: checkForHumanReply,
  });

export const pullRequestGate: GateFn = (pr) =>
  pullRequestGateBlock(pr, fetchPrState);

export function agentOrHalt<T = undefined>(
  claim: TicketClaim,
  config: AgentStepConfig<T>,
) {
  return agentOrHaltBlock(claim, config, { agent, haltForHuman });
}

type ReviewTicketInput = Omit<
  ReviewTicketOptions,
  "agent" | "haltForHuman" | "fetchSnapshot" | "postNote"
>;

// Parks on a needs-human verdict and re-reads the ticket each round until the
// review proceeds, so the caller gets a brief, not a verdict to branch on.
export function reviewTicket(options: ReviewTicketInput): Promise<Handoff> {
  return reviewTicketBlock({
    ...options,
    agent,
    haltForHuman,
    postNote: postTicketNote,
    fetchSnapshot: fetchTicketSnapshot,
  });
}
