# jigs.config.ts loads .env.local, then .env, and never replaces a value that is already set:
# the shell wins, then .env.local, then .env. Keep both files out of version control.
# Also set any variable your jigs.config.ts or workflows name, such as an MCP server's
# bearerTokenEnv, in the section it belongs to.

# ---- Shared values: the same in every copy of this factory ----
# Copy this file to .env and fill in what your workflows need: API keys, secrets, channel IDs.
# Copy that .env into each new worktree.

# World, the database that keeps every run's state: always needed.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Models, agents and AWS: a workflow whose requires names models.openrouter(), agents or aws.
# For models.openrouter(): an API key from openrouter.ai.
OPENROUTER_API_KEY=
# For Claude Code agents: the path to claude, when it is not on the service's PATH.
JIGS_CLAUDE_EXECUTABLE=
# For requires: { aws: true }: the AWS profile those workflows use.
AWS_PROFILE=

# ---- This copy's values: only this checkout's ----
# Put these in .env.local, uncommented, and never copy .env.local to another checkout. They stay
# commented here so that .env never carries them.

# Each copy on a machine needs its own docker compose project and ports. jigs init suggested these.
# COMPOSE_PROJECT_NAME={{FACTORY_NAME}}
# JIGS_SERVICE_PORT={{SERVICE_PORT}}
# JIGS_DASHBOARD_PORT={{DASHBOARD_PORT}}
# JIGS_POSTGRES_PORT={{POSTGRES_PORT}}
# This copy's World, on JIGS_POSTGRES_PORT: always needed.
# WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:{{POSTGRES_PORT}}/jigs

# Hub: only once a workflow, binding or trigger uses GitHub, Linear, Slack or PagerDuty.
# The factory token the hub showed when you added this copy's factory.
# JIGS_HUB_TOKEN=<token>

# Triggers and schedules: one <NAME>_ACTIVE=true for each one this copy runs, plus any per-copy
# value it reads, such as a test channel.
