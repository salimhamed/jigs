# Copy this file to .env and keep .env out of version control.
# A new factory needs only the World and hub sections; fill in the others when it needs them.
# Also set any variable your jigs.config.ts names, such as an MCP server's bearerTokenEnv.

# World, the database that keeps every run's state: always needed, filled in by jigs init.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:{{POSTGRES_PORT}}/jigs

# Hub, which GitHub events reach this factory through: always needed.
# The factory token the hub shows once, when you add the factory; `pnpm exec jigs hub connect` sets it.
JIGS_HUB_TOKEN=

# GitHub: github.identities [{ mode: "pat" }], once you bind a repository or a workflow requires github.
# A GitHub personal access token; jigs acts on GitHub as you.
GITHUB_TOKEN=

# Linear: a workflow that requires linear; linear.identity.mode picks the keys.
# With mode: "key": a personal API key from your Linear account settings.
LINEAR_API_KEY=
# With mode: "app": the client ID and secret of your Linear OAuth app.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# PagerDuty: a pagerduty section in jigs.config.ts.
# The client ID and secret of your PagerDuty scoped OAuth app.
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Slack: a slack section in jigs.config.ts, or a workflow that requires slack.
# The bot token (xoxb-...) from your Slack app's OAuth & Permissions page.
SLACK_BOT_TOKEN=
# Only with slack.socketMode: true: the app-level token (xapp-...) from Basic Information.
SLACK_APP_TOKEN=

# Models, agents and AWS: a workflow whose requires names models.openrouter(), agents or aws.
# For models.openrouter(): an API key from openrouter.ai.
OPENROUTER_API_KEY=
# For Claude Code agents: the path to claude, when it is not on the service's PATH.
JIGS_CLAUDE_EXECUTABLE=
# For requires: { aws: true }: the AWS profile those workflows use.
AWS_PROFILE=

# Webhooks: each secret only when webhooks.<provider>.enabled is true in jigs.config.ts.
# The signing secret from your Linear webhook's settings page.
LINEAR_WEBHOOK_SECRET=
# The signing secret PagerDuty shows once, when you create the webhook subscription.
PAGERDUTY_WEBHOOK_SECRET=
