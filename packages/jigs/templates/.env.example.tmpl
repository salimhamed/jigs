# Values every copy of this factory shares: API keys, secrets, channel IDs.
# Copy this file to .env, fill in what your workflows need, and copy that .env into each new
# worktree. This copy's own values go in .env.local; see .env.local.example.
# jigs.config.ts loads .env.local, then .env, and never replaces a value that is already set.
# Keep .env out of version control. Also set here any variable your jigs.config.ts or workflows
# name, such as an MCP server's bearerTokenEnv, when every copy shares it.

# World, the database that keeps every run's state: always needed.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres

# Models, agents and AWS: a workflow whose requires names models.openrouter(), agents or aws.
# For models.openrouter(): an API key from openrouter.ai.
OPENROUTER_API_KEY=
# For Claude Code agents: the path to claude, when it is not on the service's PATH.
JIGS_CLAUDE_EXECUTABLE=
# For requires: { aws: true }: the AWS profile those workflows use.
AWS_PROFILE=
