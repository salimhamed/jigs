import { defineFactory } from "@jigs-ai/jigs";

export default defineFactory({
  // GitHub events reach this factory through its hub. Set this and the token
  // with: pnpm exec jigs hub connect <url> <token>
  hub: { url: "https://hub.example.com" },
  service: { port: {{SERVICE_PORT}}, dashboardPort: {{DASHBOARD_PORT}} },
  // Parked runs re-read Linear every 300 seconds by default.
  // Webhooks are optional: they wake runs sooner, and need a public URL.
  // webhooks: {
  //   url: "https://<machine>.<tailnet>.ts.net",
  //   linear: { enabled: true }, // also pagerduty; a provider left out is off
  // },
  bindings: {},
  // Agents get only a small base environment; name any other variable they need.
  // agents: { env: ["SSH_AUTH_SOCK"] },
  // App mode maps account logins to installation IDs: installations: { owner: 123 }
{{GITHUB_IDENTITY}}
{{LINEAR_IDENTITY}}
  // These loaders stay relative: they register workflow files for the build,
  // rather than being import sites factory code reads from.
  workflows: {
    hello: () => import("./workflows/hello/hello.ts"),
  },
});
