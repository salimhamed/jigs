import type { Factory } from "@salimhamed/jigs";
import { shipInputs, shipPipeline } from "./pipelines/ship.ts";

// This factory's pipelines, keyed by the name `jigs run` takes. `jigs build`
// generates the service entry from this file.
export default {
  pipelines: {
    // A ticket to a merged PR. `requires` is what preflight checks before a
    // run exists: add `bindings: ["<name>"]` once jigs.yml declares one.
    ship: {
      pipeline: shipPipeline,
      inputs: shipInputs,
      requires: { harnesses: ["claude", "codex"] },
    },
  },
} satisfies Factory;
