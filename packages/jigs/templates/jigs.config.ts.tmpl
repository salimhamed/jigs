import { existsSync } from "node:fs";
import { defineFactory } from "@jigs-ai/jigs";

// jigs reads only the process environment. A value already set is kept, so the shell wins,
// then .env.local, then .env.
for (const file of [".env.local", ".env"]) {
  if (existsSync(file)) process.loadEnvFile(file);
}

export default defineFactory({
  // Needed once a workflow, binding or trigger uses GitHub, Linear, Slack or PagerDuty; this
  // copy's token goes in JIGS_HUB_TOKEN. They name each installation they use by the name an
  // admin gave it on the hub.
  // hub: { url: "https://hub.example.com" },
  bindings: {},
  // Agents get only a small base environment; name any other variable they need.
  // agents: { env: ["SSH_AUTH_SOCK"] },
  // Name yourself to be assigned every pull request jigs opens.
  // github: { operator: "your-github-login" },
  // Name yourself to be mentioned in every question and note a ticket run posts in Linear.
  // linear: { operator: "you@example.com" },
  // These loaders stay relative: they register workflow files for the build,
  // rather than being import sites factory code reads from.
  workflows: {
    hello: () => import("./workflows/hello/hello.ts"),
  },
  // Schedules and triggers start runs only while active; set HELLO_NIGHTLY_ACTIVE=true in the
  // environment of the copy that should fire this one.
  // schedules: {
  //   "hello-nightly": {
  //     active: process.env.HELLO_NIGHTLY_ACTIVE === "true",
  //     workflow: "hello",
  //     cron: "0 3 * * *",
  //     inputs: {},
  //   },
  // },
});
