# Copy to ~/.config/jigs/service.env (referenced by jigs-service.service).
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:5439/jigs
PORT=8990

# Consumed by the suspension primitives (needsHuman, pullRequestGate) and by
# trigger-path preflight later.
LINEAR_API_KEY=
GITHUB_TOKEN=
