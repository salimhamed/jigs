{
  "name": "jigs-workspace",
  "version": "0.102.1",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node packages/jigs/src/cli/cli.ts",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:db": "pnpm -r --workspace-concurrency=1 --if-present test:db",
    "test:live": "pnpm --filter @jigs-ai/jigs test:live",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check . && pnpm -r --if-present depcruise",
    "lint:fix": "biome check --write .",
    "docs": "node tools/api-docs/docs.mjs",
    "docs:site": "node tools/api-docs/docs.mjs --site",
    "docs:preview": "pnpm --filter @jigs/api-docs exec vitepress preview ../../site",
    "docs:check": "node tools/api-docs/docs.mjs --check",
    "docs:examples": "node tools/api-docs/examples.mjs",
    "e2e": "pnpm --filter @jigs-ai/jigs e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9"
  },
  "packageManager": "pnpm@11.21.0"
}
