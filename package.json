{
  "name": "@salimhamed/jigs",
  "version": "0.38.1",
  "description": "Guides coding agents through repeatable workflows",
  "type": "module",
  "license": "MIT",
  "author": "Salim Hamed",
  "repository": {
    "type": "git",
    "url": "https://github.com/salimhamed/jigs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jigs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./nitro": {
      "types": "./dist/nitro.d.ts",
      "default": "./dist/nitro.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "default": "./dist/schedules.js"
    },
    "./automatic-release": {
      "types": "./dist/automatic-release.d.ts",
      "default": "./dist/automatic-release.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./plugins/start-world": {
      "types": "./dist/plugins/start-world.d.ts",
      "default": "./dist/plugins/start-world.js"
    },
    "./plugins/start-dashboard": {
      "types": "./dist/plugins/start-dashboard.d.ts",
      "default": "./dist/plugins/start-dashboard.js"
    },
    "./blocks/agents": {
      "types": "./dist/blocks/agents/index.d.ts",
      "default": "./dist/blocks/agents/index.js"
    },
    "./blocks/human": {
      "types": "./dist/blocks/human/index.d.ts",
      "default": "./dist/blocks/human/index.js"
    },
    "./blocks/linear": {
      "types": "./dist/blocks/linear/index.d.ts",
      "default": "./dist/blocks/linear/index.js"
    },
    "./blocks/pull-requests": {
      "types": "./dist/blocks/pull-requests/index.d.ts",
      "default": "./dist/blocks/pull-requests/index.js"
    },
    "./blocks/workspaces": {
      "types": "./dist/blocks/workspaces/index.d.ts",
      "default": "./dist/blocks/workspaces/index.js"
    },
    "./blocks/git": {
      "types": "./dist/blocks/git/index.d.ts",
      "default": "./dist/blocks/git/index.js"
    },
    "./blocks/runtime": {
      "types": "./dist/blocks/runtime/index.d.ts",
      "default": "./dist/blocks/runtime/index.js"
    },
    "./steps/agents": {
      "types": "./dist/steps/agents/index.d.ts",
      "default": "./dist/steps/agents/index.js"
    },
    "./steps/human": {
      "types": "./dist/steps/human/index.d.ts",
      "default": "./dist/steps/human/index.js"
    },
    "./steps/linear": {
      "types": "./dist/steps/linear/index.d.ts",
      "default": "./dist/steps/linear/index.js"
    },
    "./steps/pull-requests": {
      "types": "./dist/steps/pull-requests/index.d.ts",
      "default": "./dist/steps/pull-requests/index.js"
    },
    "./steps/workspaces": {
      "types": "./dist/steps/workspaces/index.d.ts",
      "default": "./dist/steps/workspaces/index.js"
    },
    "./steps/git": {
      "types": "./dist/steps/git/index.d.ts",
      "default": "./dist/steps/git/index.js"
    },
    "./steps/runtime": {
      "types": "./dist/steps/runtime/index.d.ts",
      "default": "./dist/steps/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "recipes",
    "migrations"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "node src/cli/cli.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "e2e": "node e2e/check-step-ids.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.79",
    "ai-sdk-provider-claude-code": "4.3.1",
    "ai-sdk-provider-codex-cli": "2.2.1",
    "commander": "^15.0.0",
    "croner": "10.0.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.4",
    "jiti": "^2.7.0",
    "pg": "8.20.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.8.0",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@workflow/web": "5.0.0-beta.53",
    "@workflow/world-postgres": "5.0.0-beta.44",
    "nitro": "3.0.260610-beta",
    "workflow": "5.0.0-beta.53",
    "zod": "4.5.4"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@types/pg": "8.23.1",
    "@types/semver": "^7.8.0",
    "@workflow/web": "5.0.0-beta.53",
    "@workflow/world": "5.0.0-beta.36",
    "@workflow/world-postgres": "5.0.0-beta.44",
    "nitro": "3.0.260610-beta",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "workflow": "5.0.0-beta.53",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@11.21.0"
}
