{
  "name": "jigs-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Salim Hamed",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter jigs dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "e2e": "pnpm -C e2e/fixture-factory install --frozen-lockfile && node e2e/check-step-ids.mjs && pnpm -C e2e/fixture-factory typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
