{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [{ "name": "workflow" }]
  },
  "include": [
    "workflows/**/*.ts",
    "jigs/**/*.ts",
    "jigs.config.ts",
    "jigs.config.test.ts",
    "nitro.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".jigs"]
}
