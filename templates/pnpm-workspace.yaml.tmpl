# Native dependencies needed by the workflow compiler.
allowBuilds:
  '@swc/core': true
  cbor-extract: true
  esbuild: true
# Reject incompatible runtime and schema-library versions.
strictPeerDependencies: true
# jigs runs the `codex` on PATH, so the provider's optional copy is 320 MB
# that would never run.
ignoredOptionalDependencies:
  - '@openai/codex'
# jigs upgrades immediately after release; other packages remain age-checked.
minimumReleaseAgeExclude:
  - '@salimhamed/jigs'
