import { type WorkflowEntry, type WorkflowInputs } from "@salimhamed/jigs";
import { claude, codex } from "@salimhamed/jigs/agents";
import { z } from "zod";
import { acquireLinearTicket, workItemFromHandoff } from "../blocks/tickets/linear.ts";
import {
  provisionWorktree,
  removeMergedRunWorktrees,
  reviewLoop,
  reviewTicket,
} from "../jigs.ts";

export const shipInputs = z.object({
  ticket: z.string().min(1),
  binding: z.string(),
  merge: z.enum(["jigs", "human"]).default("human"),
  implementationHarness: z.enum(["claude", "codex"]).default("codex"),
  implementationModel: z.string().min(1).default("gpt-5.6-sol"),
  reviewHarness: z.enum(["claude", "codex"]).default("claude"),
  reviewModel: z.string().min(1).default("opus"),
  reviewRounds: z.number().int().positive().default(3),
  ciFixAttempts: z.number().int().nonnegative().default(3),
  pullRequestRevisionRounds: z.number().int().nonnegative().default(3),
});

type ShipInputs = WorkflowInputs<typeof shipInputs>;

/** Take a Linear ticket through implementation, review, and pull-request merge. */
export async function shipWorkflow(inputs: ShipInputs) {
  "use workflow";

  const { claim, snapshot } = await acquireLinearTicket(inputs.ticket);
  const worktree = await provisionWorktree({
    binding: inputs.binding,
    branch: snapshot.branchName,
  });
  const handoff = await reviewTicket({
    claim,
    snapshot,
    harness: claude({ model: "opus" }),
    cwd: worktree.path,
  });
  const implementationHarness = inputs.implementationHarness === "claude" ? claude : codex;
  const reviewHarness = inputs.reviewHarness === "claude" ? claude : codex;
  const result = await reviewLoop({
    task: workItemFromHandoff(handoff),
    worktree,
    binding: inputs.binding,
    implementation: { harness: implementationHarness({ model: inputs.implementationModel }) },
    review: { harness: reviewHarness({ model: inputs.reviewModel }) },
    limits: {
      implementationReviewRounds: inputs.reviewRounds,
      ciFixAttempts: inputs.ciFixAttempts,
      pullRequestRevisionRounds: inputs.pullRequestRevisionRounds,
    },
    merge: inputs.merge,
  });

  if (result.status === "merged") await removeMergedRunWorktrees();
  return result;
}

export default {
  workflow: shipWorkflow,
  inputs: shipInputs,
  requires: { harnesses: ["claude", "codex"], integrations: ["linear", "github"] },
} satisfies WorkflowEntry<typeof shipInputs>;
