# Copy this file to .env and keep .env out of version control.
# A new factory needs only the World section. Fill in the others when a
# setting in jigs.config.ts, or a workflow you add, needs them.

# World: the database where jigs keeps the state of every run. Always needed.
# jigs init filled these in for the Postgres in docker-compose.yml.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:{{POSTGRES_PORT}}/jigs

# GitHub: needed with github.identities [{ mode: "pat" }], once you bind a
# repository. A GitHub App (mode: "app") makes its own tokens instead.
# A GitHub personal access token; jigs acts on GitHub as you.
GITHUB_TOKEN=

# Linear: needed by workflows that use Linear. linear.identity.mode picks the keys.
# With mode: "key": a personal API key from your Linear account settings.
LINEAR_API_KEY=
# With mode: "app": the client ID and secret of your Linear OAuth app.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# PagerDuty: needed when jigs.config.ts has a pagerduty section.
# The client ID and secret of your PagerDuty scoped OAuth app.
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Slack: needed when jigs.config.ts has a slack section.
# The bot token (xoxb-...) from your Slack app's OAuth & Permissions page.
SLACK_BOT_TOKEN=
# Only with slack.socketMode: true. The app-level token (xapp-...) from your
# Slack app's Basic Information page.
SLACK_APP_TOKEN=

# Models and agents: needed by the workflows that use them.
# For models.openrouter(): an API key from openrouter.ai.
OPENROUTER_API_KEY=
# The path to the claude command, when it is not on the service's PATH.
JIGS_CLAUDE_EXECUTABLE=
# For workflows with requires: { aws: true }: the AWS profile they use. Left
# commented out because an empty value would hide the profile your shell sets.
# AWS_PROFILE=

# Webhooks: each secret is needed only when its provider is enabled, such as
# webhooks.github.enabled in jigs.config.ts.
# A secret you make with `openssl rand -hex 32`; jigs bind gives it to GitHub.
GITHUB_WEBHOOK_SECRET=
# The signing secret from your Linear webhook's settings page.
LINEAR_WEBHOOK_SECRET=
# The signing secret PagerDuty shows once, when you create the webhook subscription.
PAGERDUTY_WEBHOOK_SECRET=
