# Copy to .env and keep credentials out of version control.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgres://jigs:jigs@localhost:{{POSTGRES_PORT}}/jigs

# Optional integrations; hello needs neither credential.
# Set these when adding a workflow such as the ship recipe.
LINEAR_API_KEY=
# Only read when github.identity.mode is "pat"; an App mints its own tokens.
GITHUB_TOKEN=
# Required by workflows that use models.openrouter().
# OPENROUTER_API_KEY=

# Signing secret of the org-level Linear webhook.
LINEAR_WEBHOOK_SECRET=

# Signs the GitHub webhook deliveries jigs bind registers; jigs never
# generates it. Create one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
