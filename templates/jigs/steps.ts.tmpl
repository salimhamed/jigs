export async function provisionWorktree(request: WorktreeRequest): Promise<Worktree> {
  "use step";
  const metadata = getWorkflowMetadata();
  const worktree = await workspacesOperations.provisionWorktree(request, metadata);
  await runtimeOperations.registerResource({
    kind: "worktree",
    identity: worktree.path,
    url: localFileUrl(worktree.path),
  });
  return worktree;
}

