// This factory's PR conventions — the words, kept apart from the mechanics in
// ./describe-and-open-pr.ts. Rewrite them: whatever comes
// back is what GitHub is handed. Both prompts are built from the one
// conventions() string so a resumed description and a rebuilt one cannot come
// back to different rules.

import {
  type Handoff,
  renderSnapshot,
  type TicketSnapshot,
} from "@salimhamed/jigs/blocks";

export function prDescriptionPrompts(handoff: Handoff): {
  resumePrompt: string;
  freshPrompt: (diff: string) => string;
} {
  const ticket = handoff.snapshot;
  return {
    resumePrompt: conventions(ticket),
    freshPrompt: (diff: string) =>
      [
        conventions(ticket),
        "",
        "## Ticket",
        "",
        renderSnapshot(ticket),
        "",
        "## Brief",
        "",
        handoff.brief,
        "",
        "## Diff",
        "",
        diff,
      ].join("\n"),
  };
}

function conventions(ticket: TicketSnapshot): string {
  return [
    "Write the title and body of the pull request for this change.",
    "",
    `- Title: \`${ticket.identifier}: \` then a short imperative summary.`,
    "- Body: what changed and why, in prose a reviewer can read in a minute.",
    `- End the body with a link to the ticket: ${ticket.url}`,
  ].join("\n");
}
