import type { WorktreeFacts } from "@salimhamed/jigs";
import {
  claude,
  describePullRequest,
  type Handoff,
  type PrRef,
  type TicketSnapshot,
} from "@salimhamed/jigs/blocks";
import { agent, openPullRequest, readWorktreeDiff, resolveRepository } from "../../jigs.ts";
import type { Builder } from "./builder.ts";
import { pullRequestDescriptionPrompts } from "./describe-pr.prompt.ts";

export async function describeAndOpenPullRequest(
  builder: Builder,
  worktree: WorktreeFacts,
  handoff: Handoff,
  binding: string,
): Promise<PrRef> {
  const ticket = handoff.snapshot;
  const prompts = pullRequestDescriptionPrompts(handoff);

  const described = await describePullRequest({
    agent,
    readWorktreeDiff,
    harness: claude({ model: "opus" }),
    cwd: builder.cwd,
    baseSha: worktree.baseSha,
    ...(builder.session === undefined ? {} : { session: builder.session }),
    resumePrompt: prompts.resumePrompt,
    freshPrompt: prompts.freshPrompt,
  });

  const { title, body } = repaired(described, ticket);
  const repo = await resolveRepository(binding);
  return openPullRequest(repo, worktree.branch, worktree.defaultBranch, title, body);
}

function repaired(description: { title: string; body: string }, ticket: TicketSnapshot) {
  let { title, body } = description;
  if (!title.startsWith(`${ticket.identifier}: `)) {
    console.log(
      `[describePullRequest] prefixing ${ticket.identifier} onto ${JSON.stringify(title)}`,
    );
    title = `${ticket.identifier}: ${title}`;
  }
  if (!body.includes(ticket.url)) {
    console.log("[describePullRequest] body carries no ticket link — appending one");
    body = `${body}\n\n[${ticket.identifier}](${ticket.url})`;
  }
  return { title, body };
}
