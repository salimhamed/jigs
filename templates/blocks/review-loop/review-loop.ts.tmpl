import type { WorktreeFacts } from "@salimhamed/jigs";
import {
  attend,
  finished,
  type Handoff,
  type HarnessConfig,
  implementUntilCodeReviewApproves,
  type PrRef,
  type TicketClaim,
  unreachable,
} from "@salimhamed/jigs/blocks";
import { agent, haltForHuman, pullRequestGate } from "../../jigs.ts";
import type { Builder } from "./builder.ts";
import { describeAndOpenPullRequest } from "./describe-and-open-pr.ts";
import { ciFixer } from "./fix-red-ci.ts";
import { squashMergeOnApproval, waitForHumanMerge } from "./merge-on-approval.ts";
import { pushImplementation } from "./push-implementation.ts";
import { respondToReview } from "./respond-to-review.ts";

export interface ReviewLoopOptions {
  claim: TicketClaim;
  handoff: Handoff;
  // Reusing the builder's session requires the same harness.
  harness: HarnessConfig;
  worktree: WorktreeFacts;
  binding: string;
  merge: "jigs" | "human";
}

export type ReviewLoopResult = { pr: PrRef; cycles: number };

/** Run implementation and review until the pull request merges; fail if it closes unmerged. */
export async function reviewLoop(options: ReviewLoopOptions): Promise<ReviewLoopResult> {
  const { handoff, worktree } = options;

  const built = await implementUntilCodeReviewApproves({
    agent,
    haltForHuman,
    claim: options.claim,
    handoff,
    harness: options.harness,
    cwd: worktree.path,
    baseSha: worktree.baseSha,
  });
  const builder: Builder = {
    harness: options.harness,
    cwd: worktree.path,
    ...(built.session === undefined ? {} : { session: built.session }),
  };

  await pushImplementation(builder, worktree);
  const pr = await describeAndOpenPullRequest(builder, worktree, handoff, options.binding);
  const ci = ciFixer(pr, builder, worktree, handoff);

  return attend<ReviewLoopResult>(
    pullRequestGate(pr),
    async (wake) => {
      switch (wake.kind) {
        case "review-comments":
        case "changes-requested":
          return respondToReview(wake, pr, builder, worktree, handoff);
        case "ci-red":
          return ci.onRed(wake);
        case "ci-green":
          return ci.onGreen();
        case "approved":
          return options.merge === "human"
            ? waitForHumanMerge(wake)
            : squashMergeOnApproval(pr, wake, built.cycles);
        case "closed":
          if (wake.merged) return finished({ pr, cycles: built.cycles });
          throw new Error(
            `pull request ${pr.owner}/${pr.repo}#${pr.number} was closed without merging`,
          );
        default:
          return unreachable(wake);
      }
    },
    `${pr.owner}/${pr.repo}#${pr.number}`,
  );
}
