// Run real blocks with durable steps replaced by test doubles.

import type { ReviewThread, WorktreeFacts } from "@salimhamed/jigs";
import {
  type AgentStepConfig,
  type AgentStepResult,
  claude,
  type GateAck,
  type GateWake,
  type Handoff,
  type PrRef,
  parseOutput,
  type TicketClaim,
  type TicketSnapshot,
  unwrapAgentStep,
} from "@salimhamed/jigs/blocks";
import { beforeEach, expect, test, vi } from "vitest";
import { reviewLoop } from "./review-loop.ts";

type BranchState = { commits: number; headSha: string; dirty: boolean };
type RepoRef = { owner: string; repo: string };
type CiRed = Extract<GateWake, { kind: "ci-red" }>;

const shared = vi.hoisted(() => ({
  calls: {
    trail: [] as string[],
    agent: [] as AgentStepConfig<unknown>[],
    bindings: [] as string[],
    branchStates: [] as Array<[string, string]>,
    pushes: [] as Array<[string, string]>,
    replies: [] as Array<[number, string]>,
    comments: [] as string[],
    merges: [] as number[],
    opens: [] as Array<[RepoRef, string, string, string, string]>,
    acks: [] as GateAck[],
    haltForHuman: 0,
    gateFinished: false,
  },
  script: {
    wakes: [] as GateWake[],
    outputs: [] as unknown[],
    branch: (() => ({
      commits: 1,
      headSha: "head-1",
      dirty: false,
    })) as (nth: number) => BranchState,
    pushHead: ((nth: number) => ({ headSha: `pushed-${nth}` })) as (nth: number) => {
      headSha: string;
    },
    // Match by prompt so adding earlier calls does not move the simulated failure.
    staleResume: (() => false) as (config: AgentStepConfig<unknown>) => boolean,
    mergeError: null as Error | null,
  },
  pr: { owner: "acme", repo: "api", number: 41 } as PrRef,
}));

vi.mock("../../jigs.ts", () => {
  const { calls, script, pr } = shared;
  async function* deliver(): AsyncGenerator<GateWake, void, GateAck | undefined> {
    try {
      for (const wake of script.wakes) {
        calls.trail.push(`wake ${wake.kind}`);
        const ack = yield wake;
        if (ack !== undefined) calls.acks.push(ack);
      }
      calls.gateFinished = true;
    } finally {
      calls.trail.push("gate closed");
    }
  }
  return {
    agent: async <T>(config: AgentStepConfig<T>): Promise<AgentStepResult<T>> => {
      calls.trail.push("agent");
      calls.agent.push(config as AgentStepConfig<unknown>);
      if (config.resume !== undefined && script.staleResume(config as AgentStepConfig<unknown>)) {
        unwrapAgentStep({ resumeFailed: "no rollout for thread id 0199-gone" });
      }
      const raw = config.output === undefined ? undefined : script.outputs.shift();
      return {
        text: "",
        output: parseOutput(config.output, raw),
        session: { harness: "claude", id: `s-${calls.agent.length}` },
      };
    },
    haltForHuman: async () => {
      calls.trail.push("haltForHuman");
      calls.haltForHuman += 1;
      return {
        commentId: "c1",
        body: "carry on",
        author: { id: "u1", name: "salim" },
        createdAt: "2026-08-26T14:00:00Z",
      };
    },
    pullRequestGate: (_target: PrRef) => {
      calls.trail.push("gate");
      return deliver();
    },
    resolveRepository: async (binding: string) => {
      calls.trail.push("resolveRepository");
      calls.bindings.push(binding);
      return { owner: pr.owner, repo: pr.repo };
    },
    readBranchState: async (path: string, baseSha: string) => {
      calls.trail.push("readBranchState");
      calls.branchStates.push([path, baseSha]);
      return script.branch(calls.branchStates.length);
    },
    pushBranch: async (path: string, branch: string) => {
      calls.trail.push("push");
      calls.pushes.push([path, branch]);
      return script.pushHead(calls.pushes.length);
    },
    readWorktreeDiff: async (_path: string, _baseSha: string) => {
      calls.trail.push("readWorktreeDiff");
      return "THE-DIFF";
    },
    openPullRequest: async (
      repo: RepoRef,
      head: string,
      base: string,
      title: string,
      body: string,
    ) => {
      calls.trail.push("openPullRequest");
      calls.opens.push([repo, head, base, title, body]);
      return pr;
    },
    replyToPullRequestReviewThread: async (_target: PrRef, rootId: number, body: string) => {
      calls.trail.push("reply");
      calls.replies.push([rootId, body]);
      return { id: rootId + 1 };
    },
    commentOnPullRequest: async (_target: PrRef, body: string) => {
      calls.trail.push("comment");
      calls.comments.push(body);
    },
    squashMergePullRequest: async (target: PrRef) => {
      calls.trail.push("merge");
      if (script.mergeError !== null) throw script.mergeError;
      calls.merges.push(target.number);
      return { merged: true, sha: "merge-sha" };
    },
  };
});

const { calls, script, pr } = shared;

const claim = {
  issueId: "68bc9696-35d5-442d-ab56-214c8cfefbec",
  identifier: "AGE-316",
  token: "linear:ticket:68bc9696-35d5-442d-ab56-214c8cfefbec",
} as TicketClaim;

const snapshot: TicketSnapshot = {
  fetchedAt: "2026-08-26T13:00:00Z",
  id: claim.issueId,
  identifier: "AGE-316",
  title: "Review loop jig",
  description: "## Acceptance criteria\n\n- the builder answers in-thread",
  url: "https://linear.app/x/issue/AGE-316",
  branchName: "salimhamed/age-316-review-loop",
  state: "Todo",
  labels: [],
  comments: [],
  blockedBy: [],
  blocks: [],
  links: [],
  subIssues: [],
};

const handoff: Handoff = { brief: "build it", snapshot, assumptions: [] };

const worktree: WorktreeFacts = {
  path: "/tmp/worktree",
  branch: snapshot.branchName,
  defaultBranch: "main",
  baseSha: "base-sha-1",
};

const thread = (rootId: number): ReviewThread => ({
  rootId,
  path: "src/gate.ts",
  line: 12,
  comments: [
    {
      id: rootId,
      rootId,
      body: `comment on ${rootId}`,
      user: "reviewer",
      path: "src/gate.ts",
      line: 12,
      createdAt: "2026-08-26T12:00:00Z",
    },
  ],
});

const failing: CiRed["failing"] = [
  { name: "test", conclusion: "failure", url: "http://ci.test/1" },
];

const ciRed = (headSha: string, mentionLogin: string | null = "salim"): GateWake => ({
  kind: "ci-red",
  headSha,
  failing,
  mentionLogin,
});

const closedMerged: GateWake = { kind: "closed", merged: true };

const approval: GateWake = {
  kind: "approved",
  reviewId: 7,
  reviewer: "salim",
  submittedAt: "2026-08-26T12:00:00Z",
};

const approved = { verdict: "approved", findings: [] };

const description = { title: "described title", body: "described body" };

const answerFor = (rootIds: number[]) => ({
  answers: rootIds.map((threadId) => ({
    threadId,
    body: `answered ${threadId}`,
  })),
});

// Simulate uncommitted work until the recovery attempt succeeds.
const emptyBranches =
  (empty: number) =>
  (nth: number): BranchState =>
    nth > empty
      ? { commits: 1, headSha: `head-${nth}`, dirty: false }
      : { commits: 0, headSha: "base-sha-1", dirty: true };

const commitRounds = () =>
  calls.agent.filter((call) => call.prompt.startsWith("# Commit your work"));

const ciFixes = () => calls.agent.filter((call) => call.prompt.startsWith("# Fix CI"));

const run = (merge: "jigs" | "human" = "jigs") =>
  reviewLoop({
    claim,
    handoff,
    harness: claude({ model: "sonnet" }),
    worktree,
    binding: "scratch",
    merge,
  });

beforeEach(() => {
  // Preserve the object references captured by the hoisted mocks.
  Object.assign(calls, {
    trail: [],
    agent: [],
    bindings: [],
    branchStates: [],
    pushes: [],
    replies: [],
    comments: [],
    merges: [],
    opens: [],
    acks: [],
    haltForHuman: 0,
    gateFinished: false,
  });
  Object.assign(script, {
    wakes: [],
    outputs: [approved, description],
    branch: (nth: number) => ({
      commits: 1,
      headSha: `head-${nth}`,
      dirty: false,
    }),
    pushHead: (nth: number) => ({ headSha: `pushed-${nth}` }),
    staleResume: () => false,
    mergeError: null,
  });
});

test("the loop implements, pushes the ticket branch and opens the PR before the gate", async () => {
  script.wakes = [closedMerged];
  const result = await run();

  expect(calls.trail).toEqual([
    "agent",
    "agent",
    "readBranchState",
    "push",
    "agent",
    "resolveRepository",
    "openPullRequest",
    "gate",
    "wake closed",
    "gate closed",
  ]);
  expect(calls.branchStates).toEqual([["/tmp/worktree", "base-sha-1"]]);
  expect(calls.pushes).toEqual([["/tmp/worktree", snapshot.branchName]]);
  expect(calls.bindings).toEqual(["scratch"]);
  expect(result).toEqual({ pr, cycles: 1 });
});

test("an empty branch with a clean tree fails loudly instead of opening an empty PR", async () => {
  script.branch = () => ({ commits: 0, headSha: "base-sha-1", dirty: false });

  await expect(run()).rejects.toThrow(snapshot.branchName);
  expect(calls.opens).toEqual([]);
  expect(commitRounds()).toEqual([]);
  expect(calls.branchStates).toHaveLength(1);
  expect(calls.pushes).toEqual([]);
});

test("an empty branch with a dirty worktree sends the builder back to commit", async () => {
  script.wakes = [closedMerged];
  script.branch = emptyBranches(1);
  const result = await run();

  const rounds = commitRounds();
  expect(rounds).toHaveLength(1);
  expect(rounds[0]?.resume).toEqual({ harness: "claude", id: "s-1" });
  expect(rounds[0]?.cwd).toBe("/tmp/worktree");
  expect(calls.branchStates).toHaveLength(2);
  expect(calls.pushes).toHaveLength(1);
  expect(calls.opens).toHaveLength(1);
  expect(result).toEqual({ pr, cycles: 1 });
});

test("a stale session commits from a fresh context rather than failing the run", async () => {
  script.wakes = [closedMerged];
  script.branch = emptyBranches(1);
  script.staleResume = (config) => config.prompt.startsWith("# Commit your work");
  const result = await run();

  const rounds = commitRounds();
  expect(rounds).toHaveLength(2);
  expect(rounds[0]?.resume).toEqual({ harness: "claude", id: "s-1" });
  expect(rounds[1]?.resume).toBeUndefined();
  // s-4 is the fresh session created after the failed resume.
  expect(calls.agent[4]?.resume).toEqual({ harness: "claude", id: "s-4" });
  expect(result).toEqual({ pr, cycles: 1 });
});

test("a commit round that still commits nothing fails the run", async () => {
  script.branch = emptyBranches(2);

  await expect(run()).rejects.toThrow("commit-recovery round");
  expect(commitRounds()).toHaveLength(1);
  expect(calls.branchStates).toHaveLength(2);
  expect(calls.pushes).toEqual([]);
  expect(calls.opens).toEqual([]);
});

test("the description this factory writes is what the PR is opened with", async () => {
  script.wakes = [closedMerged];
  await run();

  expect(calls.opens).toEqual([
    [
      { owner: pr.owner, repo: pr.repo },
      snapshot.branchName,
      worktree.defaultBranch,
      "AGE-316: described title",
      `described body\n\n[AGE-316](${snapshot.url})`,
    ],
  ]);
});

test("the description resumes the builder's session on this factory's own harness", async () => {
  script.wakes = [closedMerged];
  await run();

  const describing = calls.agent[2];
  expect(describing?.resume).toEqual({ harness: "claude", id: "s-1" });
  expect(describing?.cwd).toBe("/tmp/worktree");
  expect(describing?.harness).toEqual({ kind: "claude", model: "opus" });
  expect(describing?.prompt).toContain("AGE-316: ");
});

test("a review-comments wake answers every thread in place", async () => {
  script.outputs = [approved, description, answerFor([900, 910])];
  script.wakes = [{ kind: "review-comments", threads: [thread(900), thread(910)] }, closedMerged];
  await run();

  expect(calls.replies).toEqual([
    [900, "answered 900"],
    [910, "answered 910"],
  ]);
  expect(calls.comments).toEqual([]);
  expect(calls.pushes).toEqual([
    ["/tmp/worktree", snapshot.branchName],
    ["/tmp/worktree", snapshot.branchName],
  ]);
  expect(calls.trail).toEqual([
    "agent",
    "agent",
    "readBranchState",
    "push",
    "agent",
    "resolveRepository",
    "openPullRequest",
    "gate",
    "wake review-comments",
    "agent",
    "push",
    "reply",
    "reply",
    "wake closed",
    "gate closed",
  ]);
});

test("the ids of the replies it posts ride back into the gate", async () => {
  script.outputs = [approved, description, answerFor([900, 910])];
  script.wakes = [{ kind: "review-comments", threads: [thread(900), thread(910)] }, closedMerged];
  await run();

  // Ignore replies posted by this run when the gate next checks the thread.
  expect(calls.acks).toEqual([{ selfCommentIds: [901, 911] }]);
});

test("answers that land on the conversation ack nothing", async () => {
  script.outputs = [approved, description, { answers: [{ threadId: null, body: "addressed it" }] }];
  script.wakes = [{ kind: "review-comments", threads: [thread(900)] }, closedMerged];
  await run();

  expect(calls.comments).toEqual(["addressed it"]);
  expect(calls.acks).toEqual([]);
});

test("an answer naming a thread the wake never carried lands on the conversation", async () => {
  script.outputs = [approved, description, answerFor([900, 4242])];
  script.wakes = [{ kind: "review-comments", threads: [thread(900)] }, closedMerged];
  await run();

  expect(calls.replies).toEqual([[900, "answered 900"]]);
  expect(calls.comments).toEqual(["answered 4242"]);
});

test("a changes-requested review body is answered on the PR conversation", async () => {
  script.outputs = [
    approved,
    description,
    { answers: [{ threadId: null, body: "addressed all four" }] },
  ];
  script.wakes = [
    {
      kind: "changes-requested",
      reviewId: 7,
      reviewer: "salim",
      body: "four things need fixing",
      submittedAt: "2026-08-26T12:00:00Z",
    },
    closedMerged,
  ];
  await run();

  expect(calls.replies).toEqual([]);
  expect(calls.comments).toEqual(["addressed all four"]);
  expect(calls.agent.at(-1)?.prompt).toContain("four things need fixing");
});

test("the fourth consecutive red escalates as an @-mention instead of a fix", async () => {
  script.wakes = [ciRed("sha-1"), ciRed("sha-2"), ciRed("sha-3"), ciRed("sha-4"), closedMerged];
  await run();

  expect(calls.trail).toEqual([
    "agent",
    "agent",
    "readBranchState",
    "push",
    "agent",
    "resolveRepository",
    "openPullRequest",
    "gate",
    "wake ci-red",
    "agent",
    "readBranchState",
    "push",
    "wake ci-red",
    "agent",
    "readBranchState",
    "push",
    "wake ci-red",
    "agent",
    "readBranchState",
    "push",
    "wake ci-red",
    "comment",
    "wake closed",
    "gate closed",
  ]);
  const fixes = ciFixes();
  expect(fixes).toHaveLength(3);
  expect(fixes[0]?.prompt).toContain("attempt 1 of 3");
  expect(fixes[0]?.prompt).toContain("**test** — failure");

  expect(calls.comments).toHaveLength(1);
  expect(calls.comments[0]?.startsWith("@salim")).toBe(true);
  expect(calls.comments[0]).toContain("3 fix attempts");
  expect(calls.comments[0]).toContain("**test** — failure");
  expect(calls.haltForHuman).toBe(0);
});

test("a fix that commits nothing escalates instead of waiting for a wake that cannot come", async () => {
  script.wakes = [ciRed("sha-1"), ciRed("sha-1"), closedMerged];
  // No new commit means CI will not run again.
  script.branch = () => ({ commits: 1, headSha: "sha-1", dirty: false });
  await run();

  expect(ciFixes()).toHaveLength(1);
  expect(calls.pushes).toHaveLength(1);
  expect(calls.comments).toHaveLength(1);
  expect(calls.comments[0]?.startsWith("@salim")).toBe(true);
  expect(calls.comments[0]).toContain("produced no new commit");
  expect(calls.comments[0]).not.toContain("fix attempts");
});

test("the CI fix runs inside the builder's session rather than context-free", async () => {
  script.wakes = [ciRed("sha-1"), closedMerged];
  await run();

  expect(ciFixes()[0]?.resume).toEqual({ harness: "claude", id: "s-1" });
});

test("the CI fix does not take over the builder's session pointer", async () => {
  script.outputs = [approved, description, answerFor([900])];
  script.wakes = [
    ciRed("sha-1"),
    { kind: "review-comments", threads: [thread(900)] },
    closedMerged,
  ];
  await run();

  expect(calls.agent.at(-1)?.resume).toEqual({ harness: "claude", id: "s-1" });
});

test("a stale session sends the CI fix into a fresh context that then holds the change", async () => {
  script.outputs = [approved, description, answerFor([900])];
  script.staleResume = (config) => config.prompt.startsWith("# Fix CI");
  script.wakes = [
    ciRed("sha-1"),
    { kind: "review-comments", threads: [thread(900)] },
    closedMerged,
  ];
  await run();

  // The failed resume creates no session; the fresh retry is s-5.
  const fresh = calls.agent[4];
  expect(fresh?.resume).toBeUndefined();
  expect(fresh?.prompt).toContain("AGE-316");
  expect(fresh?.prompt).toContain("THE-DIFF");
  expect(calls.agent.at(-1)?.resume).toEqual({ harness: "claude", id: "s-5" });
});

test("a fifth red neither fixes nor escalates a second time", async () => {
  script.wakes = [
    ciRed("sha-1"),
    ciRed("sha-2"),
    ciRed("sha-3"),
    ciRed("sha-4"),
    ciRed("sha-5"),
    closedMerged,
  ];
  await run();

  expect(ciFixes()).toHaveLength(3);
  expect(calls.comments).toHaveLength(1);
});

test("a green run resets the consecutive-red count", async () => {
  script.wakes = [
    ciRed("sha-1"),
    ciRed("sha-2"),
    { kind: "ci-green", headSha: "sha-3" },
    ciRed("sha-4"),
    ciRed("sha-5"),
    ciRed("sha-6"),
    closedMerged,
  ];
  await run();

  expect(ciFixes()).toHaveLength(5);
  expect(calls.comments).toEqual([]);
});

test("with no reviewer to name the escalation falls back to the repo owner", async () => {
  script.wakes = [
    ciRed("sha-1", null),
    ciRed("sha-2", null),
    ciRed("sha-3", null),
    ciRed("sha-4", null),
    closedMerged,
  ];
  await run();

  expect(calls.comments[0]?.startsWith("@acme")).toBe(true);
});

test("an approval squash-merges and returns the merged PR", async () => {
  script.wakes = [approval, closedMerged];
  const result = await run();

  expect(calls.merges).toEqual([pr.number]);
  expect(result.pr).toEqual(pr);
  // Exiting early must still dispose the gate.
  expect(calls.gateFinished).toBe(false);
  expect(calls.trail.at(-1)).toBe("gate closed");
});

test("a merge GitHub refuses leaves the PR open and the run listening", async () => {
  script.wakes = [approval, { kind: "closed", merged: false }];
  script.mergeError = new Error("405 Pull Request is not mergeable");

  await expect(run()).rejects.toThrow("closed without merging");
  expect(calls.comments).toHaveLength(1);
  expect(calls.comments[0]).toContain("@salim");
  expect(calls.comments[0]).toContain("not mergeable");
});

test("in human-merges mode an approval merges nothing and keeps listening", async () => {
  script.wakes = [approval, closedMerged];
  const result = await run("human");

  expect(calls.merges).toEqual([]);
  expect(result.pr).toEqual(pr);
  expect(calls.trail.slice(-2)).toEqual(["wake closed", "gate closed"]);
});

test("a PR closed unmerged fails the run and leaves the worktree for sweep", async () => {
  script.wakes = [{ kind: "closed", merged: false }];

  await expect(run()).rejects.toThrow("closed without merging");
});

test("a gate that stops delivering before the PR closes is an error, not a silent success", async () => {
  await expect(run()).rejects.toThrow("stopped delivering wakes");
  expect(calls.gateFinished).toBe(true);
});
