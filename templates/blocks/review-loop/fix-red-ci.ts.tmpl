import type { WorktreeFacts } from "@salimhamed/jigs";
import {
  type Attend,
  fixCi,
  type GateWake,
  type Handoff,
  listen,
  type PrRef,
  renderChecks,
} from "@salimhamed/jigs/blocks";
import {
  agent,
  commentOnPullRequest,
  pushBranch,
  readBranchState,
  readWorktreeDiff,
} from "../../jigs.ts";
import type { Builder } from "./builder.ts";

const MAX_CI_ATTEMPTS = 3;

type CiRed = Extract<GateWake, { kind: "ci-red" }>;

export function ciFixer(pr: PrRef, builder: Builder, worktree: WorktreeFacts, handoff: Handoff) {
  let redInARow = 0;
  let stoodDown = false;

  return {
    async onRed(wake: CiRed): Promise<Attend<never>> {
      // Standing down is per red streak: a later red on the same streak draws
      // neither a fix nor a second comment, and a green clears it.
      if (stoodDown) return listen();

      redInARow += 1;
      if (redInARow > MAX_CI_ATTEMPTS) {
        // On GitHub rather than through haltForHuman: the conversation about
        // this pull request belongs on this pull request.
        await commentOnPullRequest(pr, ciExhausted(wake, pr.owner));
        stoodDown = true;
        return listen();
      }

      const fixed = await fixCi({
        agent,
        readWorktreeDiff,
        harness: builder.harness,
        cwd: builder.cwd,
        ...(builder.session === undefined ? {} : { session: builder.session }),
        failing: wake.failing,
        attempt: `${redInARow} of ${MAX_CI_ATTEMPTS}`,
        handoff,
        baseSha: worktree.baseSha,
      });
      builder.session = fixed.session ?? builder.session;

      // A fix that committed nothing has no new head to push, so CI never runs
      // again and no further wake can arrive: stand down now rather than wait
      // on a wake that cannot come.
      const state = await readBranchState(builder.cwd, worktree.baseSha);
      if (state.headSha === wake.headSha) {
        await commentOnPullRequest(pr, ciMadeNoCommit(wake, pr.owner));
        stoodDown = true;
        return listen();
      }

      await pushBranch(builder.cwd, worktree.branch);
      return listen();
    },

    onGreen(): Attend<never> {
      redInARow = 0;
      stoodDown = false;
      return listen();
    },
  };
}

function ciExhausted(wake: CiRed, owner: string): string {
  return [
    `@${wake.mentionLogin ?? owner} CI is still red on \`${wake.headSha.slice(0, 8)}\` after ${MAX_CI_ATTEMPTS} fix attempts, so I am standing down rather than guessing again.`,
    "",
    renderChecks(wake.failing),
  ].join("\n");
}

function ciMadeNoCommit(wake: CiRed, owner: string): string {
  return [
    `@${wake.mentionLogin ?? owner} my CI fix attempt produced no new commit on \`${wake.headSha.slice(0, 8)}\`, so nothing will re-run and I am standing down.`,
    "",
    renderChecks(wake.failing),
  ].join("\n");
}
