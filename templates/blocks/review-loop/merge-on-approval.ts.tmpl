import { type Attend, finished, type GateWake, listen, type PrRef } from "@salimhamed/jigs/blocks";
import { commentOnPullRequest, squashMergePullRequest } from "../../jigs.ts";

type Approval = Extract<GateWake, { kind: "approved" }>;

export function waitForHumanMerge(wake: Approval): Attend<never> {
  console.log(
    `[reviewLoop] approved by ${wake.reviewer} — human-merges mode, waiting for the merge`,
  );
  return listen();
}

export async function squashMergeOnApproval(
  pr: PrRef,
  wake: Approval,
  cycles: number,
): Promise<Attend<{ pr: PrRef; cycles: number }>> {
  try {
    await squashMergePullRequest(pr);
  } catch (error) {
    await commentOnPullRequest(pr, mergeRefused(wake.reviewer, error));
    return listen();
  }
  return finished({ pr, cycles });
}

function mergeRefused(login: string, error: unknown): string {
  const reason = error instanceof Error ? error.message : String(error);
  return `@${login} I could not squash-merge this pull request: ${reason}. I am leaving it open and still listening — merge or close it yourself and I will follow.`;
}
