# Copy this file to .env.e2e.local for local end-to-end and live tests.
# The local file is gitignored. Keep credentials out of this example and out
# of commits and test output.

# Use a dedicated local Postgres database and port for e2e tests. This must
# not be a live factory World or a database used by another application.
WORKFLOW_POSTGRES_URL=postgres://e2e_user:e2e_password@127.0.0.1:55489/jigs_e2e

# Optional provider credentials for live tests. Add real values only to the
# ignored .env.e2e.local file (or provide them explicitly in the shell/CI).
OPENROUTER_API_KEY=

# Optional OpenAI-compatible server for the local-model and Pi live tests, such
# as LM Studio. Both must be set; the tests skip when the server is unreachable.
JIGS_TEST_OPENAI_COMPATIBLE_BASE_URL=
JIGS_TEST_OPENAI_COMPATIBLE_MODEL=
